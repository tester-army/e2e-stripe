# Copy to .env.local. next dev reads it, and e2e.config.ts loads it for the test runner.

# The Stripe sandbox's secret key: dashboard.stripe.com/apikeys, with the sandbox selected.
# An anonymous sandbox (`stripe sandbox create`) gives one starting with rkcs_test_.
STRIPE_SECRET_KEY=sk_test_...

# The agent's model, through the Vercel AI Gateway. Only agent steps need it.
AI_GATEWAY_API_KEY=

# Optional: test another URL. Defaults to http://localhost:3000.
# APP_URL=
